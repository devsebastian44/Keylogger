# Configuración de Laboratorio Sentinel
# Copia este archivo a .env y completa con tus datos de prueba

# Canal de Exfiltración SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_usuario@gmail.com
SMTP_PASS=tu_password_de_aplicacion
SMTP_DEST=investigador@ejemplo.com

# Configuración de Entorno
ENVIRONMENT=development
LOG_LEVEL=INFO
